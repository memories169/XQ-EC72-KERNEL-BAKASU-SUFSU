# ============================================================================
# Cau hinh bo sung cho Sony Xperia 1 VI (pdx245 / XQ-C72)
# Kernel 6.1 GKI (LineageOS android_kernel_sony_sm8650)
#
# File nay duoc merge SAU gki_defconfig + vendor/pineapple_GKI.config +
# vendor/sony/pineapple_GKI.config + vendor/sony/pdx245.config.
# ============================================================================

# ----------------------------------------------------------------------------
# Thiet bi
# ----------------------------------------------------------------------------
CONFIG_MACH_SONY_PDX245=y

# ----------------------------------------------------------------------------
# BakaSU (KernelSU)
# ----------------------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_MULTI_MANAGER_SUPPORT=n
CONFIG_KSU_TOOLKIT_SUPPORT=y

# Hook method: SUSFS inline hook (khong dung tracepoint/manual hook)
CONFIG_KSU_SUSFS=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set

# ----------------------------------------------------------------------------
# SUSFS
# ----------------------------------------------------------------------------
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# ----------------------------------------------------------------------------
# NoMount
# ----------------------------------------------------------------------------
CONFIG_NOMOUNT=y

# ----------------------------------------------------------------------------
# Enhanced networking
# ----------------------------------------------------------------------------

# TCP congestion control: BBRv3 (mac dinh) + BBRv1 du phong
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y

# Queueing disciplines
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ_PIE=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_PIE=y
CONFIG_NET_SCH_HTB=y

# Classifier / actions cho QoS, VPN, tethering
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_CTINFO=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y

# TTL / Hop Limit manipulation (cho tethering va mot so game)
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y

# IPv6 NAT (GKI da bat IPv4 NAT)
CONFIG_NF_NAT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# WireGuard (GKI da bat san, giu lai cho ro rang)
CONFIG_WIREGUARD=y

# ----------------------------------------------------------------------------
# Filesystem / network filesystem
# ----------------------------------------------------------------------------
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_CIFS_UPCALL=y
CONFIG_DNS_RESOLVER=y

# ----------------------------------------------------------------------------
# GKI / module ABI
# ----------------------------------------------------------------------------
CONFIG_MODVERSIONS=y
CONFIG_KALLSYMS_ALL=y
